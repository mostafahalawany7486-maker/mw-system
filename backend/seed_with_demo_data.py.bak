"""
Seed data for Phase 1. Run with: python seed.py
Idempotent: safe to run multiple times (checks for existing records first).
"""
from datetime import date, datetime, timedelta
from decimal import Decimal
from app.core.database import SessionLocal
from app.core.security import hash_password
from app.core.config import settings
from app.models.user import User, Role, Permission
from app.models.organization import Country, City, Currency, CompanyProfile, Branch, SystemSetting
from app.models.owner import Owner, OwnerAddress, OwnerBankAccount, OwnerContact
from app.models.lease import LeaseAgreement, LeaseStatus
from app.models.property import Property, Amenity, Floor
from app.models.tenant import Tenant, TenantContact, TenantEmergencyContact
from app.models.rental import RentalContract, RentalContractStatus, RentalPaymentInstallment, RentalInstallmentStatus
import uuid
from app.models.financial import FinancialAccount, Transaction, TransactionType, TransactionDirection, Receipt, Invoice, InvoiceStatus
from app.models.maintenance import (
    Contractor, Technician, MaintenanceRequest, MaintenanceRequestStatus, MaintenancePriority,
    MaintenanceMaterial, MaintenanceLaborCost,
)
from app.models.maintenance_contract import MaintenanceContract, MaintenanceContractStatus
from app.models.accounting import (
    ChartOfAccount, CostCenter, VatRate, PostingRule, JournalEntry, JournalEntryLine,
    EntryStatus, SourceType,
)
from app.models.reports import ReportSchedule, ReportFrequency, ReportExportFormat

# ---------------------------------------------------------------------------
# Permission catalog. Codes follow 'module.action'. Every module built in
# this and future phases should register its permissions here.
# ---------------------------------------------------------------------------
MODULES = [
    "users", "roles", "branches", "countries", "cities", "currencies",
    "company", "settings", "audit", "owners", "leases", "properties", "tenants", "rentals", "financial", "maintenance", "accounting", "reports",
    "rent_cycles", "rent_vouchers", "payments", "owner_ledger", "occupancy",
]
ACTIONS = ["view", "create", "edit", "delete"]

SYSTEM_ROLES = [
    {"name": "Administrator", "description": "Full system access", "is_system_role": True, "all_permissions": True},
    {"name": "Branch Manager", "description": "Manages a single branch's operations", "is_system_role": True,
     "permission_codes": [
         "users.view", "branches.view", "countries.view", "cities.view",
         "currencies.view", "company.view", "settings.view",
         "owners.view", "owners.create", "owners.edit",
         "leases.view", "leases.create", "leases.edit",
         "properties.view", "properties.create", "properties.edit",
         "tenants.view", "tenants.create", "tenants.edit",
         "rentals.view", "rentals.create", "rentals.edit",
         "financial.view", "financial.create", "financial.edit",
         "maintenance.view", "maintenance.create", "maintenance.edit",
         "accounting.view", "reports.view", "reports.create", "reports.edit", "reports.delete",
         "rent_cycles.view", "rent_cycles.create", "rent_cycles.edit",
         "rent_vouchers.view", "rent_vouchers.create", "rent_vouchers.edit",
         "payments.view", "payments.create", "payments.edit",
         "owner_ledger.view", "owner_ledger.create", "owner_ledger.edit",
         "occupancy.view", "occupancy.create", "occupancy.edit",
     ]},
    {"name": "Staff", "description": "Standard operational staff member", "is_system_role": True,
     "permission_codes": ["branches.view", "countries.view", "cities.view", "currencies.view", "company.view", "owners.view", "leases.view", "properties.view", "tenants.view", "rentals.view", "financial.view", "maintenance.view", "maintenance.create", "reports.view", "rent_cycles.view", "rent_vouchers.view", "rent_vouchers.create", "payments.view", "payments.create", "owner_ledger.view", "occupancy.view", "occupancy.edit"]},
]

COUNTRIES = [
    {"name": "United States", "iso_code2": "US", "iso_code3": "USA", "phone_code": "+1"},
    {"name": "United Arab Emirates", "iso_code2": "AE", "iso_code3": "ARE", "phone_code": "+971"},
    {"name": "United Kingdom", "iso_code2": "GB", "iso_code3": "GBR", "phone_code": "+44"},
    {"name": "Kuwait", "iso_code2": "KW", "iso_code3": "KWT", "phone_code": "+965"},
]

CITIES = {
    "United States": ["New York", "Los Angeles", "Chicago"],
    "United Arab Emirates": ["Dubai", "Abu Dhabi"],
    "United Kingdom": ["London", "Manchester"],
    "Kuwait": ["Kuwait City", "Hawalli", "Salmiya"],
}

CURRENCIES = [
    {"code": "USD", "name": "US Dollar", "symbol": "$", "is_base_currency": True, "exchange_rate_to_base": 1.0},
    {"code": "AED", "name": "UAE Dirham", "symbol": "د.إ", "is_base_currency": False, "exchange_rate_to_base": 3.6725},
    {"code": "GBP", "name": "British Pound", "symbol": "£", "is_base_currency": False, "exchange_rate_to_base": 0.79},
    # Kuwaiti Dinar is the strongest-valued currency in circulation, so
    # its rate-to-base (USD) is well below 1, unlike AED/GBP above —
    # this is also the currency app/core/number_to_words.py's
    # amount_to_words() already defaults to naming ("Kuwaiti Dinars" /
    # "دينار كويتي") on every printed Rental Receipt, so seeding it here
    # makes that wording match a currency that actually exists in the
    # system instead of floating disconnected from Countries/Currencies.
    {"code": "KWD", "name": "Kuwaiti Dinar", "symbol": "د.ك", "is_base_currency": False, "exchange_rate_to_base": 0.3080},
]

SYSTEM_SETTINGS = [
    {"key": "date_format", "value": "YYYY-MM-DD", "value_type": "string", "category": "general", "description": "Default date display format"},
    {"key": "theme_default", "value": "light", "value_type": "string", "category": "appearance", "description": "Default UI theme for new users"},
    {"key": "session_timeout_minutes", "value": "30", "value_type": "number", "category": "security", "description": "Idle session timeout"},
    {"key": "company_name_display", "value": "PMS Leasing Co.", "value_type": "string", "category": "general", "description": "Fallback display name before company profile is set"},
]

AMENITIES = [
    {"name": "Swimming Pool", "category": "comfort"},
    {"name": "Gym", "category": "comfort"},
    {"name": "Parking", "category": "utility"},
    {"name": "Elevator", "category": "utility"},
    {"name": "24/7 Security", "category": "safety"},
    {"name": "CCTV", "category": "safety"},
    {"name": "Central AC", "category": "comfort"},
    {"name": "Balcony", "category": "comfort"},
    {"name": "Furnished", "category": "comfort"},
    {"name": "Pet Friendly", "category": "policy"},
    {"name": "Loading Dock", "category": "utility"},
    {"name": "Fire Safety System", "category": "safety"},
]


def run():
    db = SessionLocal()
    try:
        # ---------------- Permissions ----------------
        existing_codes = {p.code for p in db.query(Permission).all()}
        for module in MODULES:
            for action in ACTIONS:
                code = f"{module}.{action}"
                if code not in existing_codes:
                    db.add(Permission(code=code, module=module, action=action, description=f"Allows '{action}' on {module}"))
        db.commit()
        print(f"✔ Permissions ensured ({len(MODULES) * len(ACTIONS)} total)")

        all_permissions = db.query(Permission).all()
        perm_by_code = {p.code: p for p in all_permissions}

        # ---------------- Roles ----------------
        for role_def in SYSTEM_ROLES:
            role = db.query(Role).filter(Role.name == role_def["name"]).first()
            if not role:
                role = Role(name=role_def["name"], description=role_def["description"], is_system_role=role_def["is_system_role"])
                db.add(role)
                db.flush()
            if role_def.get("all_permissions"):
                role.permissions = all_permissions
            else:
                role.permissions = [perm_by_code[c] for c in role_def.get("permission_codes", []) if c in perm_by_code]
        db.commit()
        print(f"✔ System roles ensured ({len(SYSTEM_ROLES)})")

        # ---------------- Countries & Cities ----------------
        country_by_name = {}
        for c in COUNTRIES:
            country = db.query(Country).filter(Country.iso_code2 == c["iso_code2"]).first()
            if not country:
                country = Country(**c)
                db.add(country)
                db.flush()
            country_by_name[c["name"]] = country
        db.commit()

        for country_name, city_names in CITIES.items():
            country = country_by_name[country_name]
            for city_name in city_names:
                exists = db.query(City).filter(City.name == city_name, City.country_id == country.id).first()
                if not exists:
                    db.add(City(name=city_name, country_id=country.id))
        db.commit()
        print(f"✔ Countries ({len(COUNTRIES)}) and cities seeded")

        # ---------------- Currencies ----------------
        for cur in CURRENCIES:
            exists = db.query(Currency).filter(Currency.code == cur["code"]).first()
            if not exists:
                db.add(Currency(**cur))
        db.commit()
        print(f"✔ Currencies ensured ({len(CURRENCIES)})")

        base_currency = db.query(Currency).filter(Currency.is_base_currency.is_(True)).first()
        us = country_by_name["United States"]
        ny = db.query(City).filter(City.name == "New York").first()

        # ---------------- Company Profile ----------------
        profile = db.query(CompanyProfile).first()
        if not profile:
            profile = CompanyProfile(
                legal_name="PMS Leasing Company LLC",
                trade_name="PMS Leasing",
                email="info@pms-demo.com",
                phone="+1-555-0100",
                address_line1="123 Main Street",
                city_id=ny.id if ny else None,
                country_id=us.id,
                base_currency_id=base_currency.id if base_currency else None,
                default_language="en",
            )
            db.add(profile)
        db.commit()
        print("✔ Company profile ensured")

        # ---------------- Head Office Branch ----------------
        branch = db.query(Branch).filter(Branch.code == "HO").first()
        if not branch:
            branch = Branch(
                name="Head Office", code="HO", email="headoffice@pms-demo.com",
                city_id=ny.id if ny else None, country_id=us.id, is_head_office=True,
            )
            db.add(branch)
        db.commit()
        print("✔ Head office branch ensured")

        # ---------------- System Settings ----------------
        for s in SYSTEM_SETTINGS:
            exists = db.query(SystemSetting).filter(SystemSetting.key == s["key"]).first()
            if not exists:
                db.add(SystemSetting(**s))
        db.commit()
        print(f"✔ System settings ensured ({len(SYSTEM_SETTINGS)})")

        # ---------------- Administrator Account ----------------
        admin_role = db.query(Role).filter(Role.name == "Administrator").first()
        admin = db.query(User).filter(User.email == settings.FIRST_ADMIN_EMAIL).first()
        if not admin:
            admin = User(
                first_name="System",
                last_name="Administrator",
                email=settings.FIRST_ADMIN_EMAIL,
                hashed_password=hash_password(settings.FIRST_ADMIN_PASSWORD),
                is_active=True,
                is_superuser=True,
                role_id=admin_role.id if admin_role else None,
                branch_id=branch.id,
            )
            db.add(admin)
            db.commit()
            print(f"✔ Administrator account created: {settings.FIRST_ADMIN_EMAIL} / {settings.FIRST_ADMIN_PASSWORD}")
        else:
            print(f"↷ Administrator account already exists: {settings.FIRST_ADMIN_EMAIL}")

        # ---------------- Sample test users (for QA/testing) ----------------
        manager_role = db.query(Role).filter(Role.name == "Branch Manager").first()
        staff_role = db.query(Role).filter(Role.name == "Staff").first()
        sample_users = [
            {"first_name": "Maria", "last_name": "Manager", "email": "maria.manager@pms-demo.com", "role_id": manager_role.id if manager_role else None},
            {"first_name": "Sam", "last_name": "Staff", "email": "sam.staff@pms-demo.com", "role_id": staff_role.id if staff_role else None},
        ]
        for u in sample_users:
            if not db.query(User).filter(User.email == u["email"]).first():
                db.add(User(
                    first_name=u["first_name"], last_name=u["last_name"], email=u["email"],
                    hashed_password=hash_password("ChangeMe!123"), is_active=True, is_superuser=False,
                    role_id=u["role_id"], branch_id=branch.id,
                ))
        db.commit()
        print("✔ Sample QA users ensured (maria.manager@pms-demo.com / sam.staff@pms-demo.com, password: ChangeMe!123)")

        # ---------------- Sample Property Owners (Phase 2) ----------------
        us_currency = db.query(Currency).filter(Currency.code == "USD").first()
        la = db.query(City).filter(City.name == "Los Angeles").first()
        dubai = db.query(City).filter(City.name == "Dubai").first()
        uae = db.query(Country).filter(Country.iso_code2 == "AE").first()

        if db.query(Owner).count() == 0:
            individual_owner = Owner(
                owner_code="OWN-000001",
                owner_type="individual",
                first_name="Robert",
                last_name="Chen",
                national_id="A1234567",
                nationality_id=us.id,
                primary_email="robert.chen" + chr(64) + "ownerdemo.com",
                primary_phone="+1-555-0199",
                branch_id=branch.id,
            )
            db.add(individual_owner)
            db.flush()
            db.add(OwnerAddress(owner_id=individual_owner.id, address_type="mailing", line1="456 Sunset Blvd", city_id=la.id if la else None, country_id=us.id, is_primary=True))
            db.add(OwnerBankAccount(owner_id=individual_owner.id, bank_name="First National Bank", account_holder_name="Robert Chen", account_number="000123456789", currency_id=us_currency.id if us_currency else None, is_primary=True))

            company_owner = Owner(
                owner_code="OWN-000002",
                owner_type="company",
                company_name="Skyline Holdings LLC",
                registration_number="REG-88213",
                tax_number="TAX-99021",
                contact_person_name="Amira Al-Farsi",
                contact_person_title="Asset Manager",
                primary_email="contact" + chr(64) + "skylineholdings.com",
                primary_phone="+971-4-555-0100",
                branch_id=branch.id,
            )
            db.add(company_owner)
            db.flush()
            db.add(OwnerAddress(owner_id=company_owner.id, address_type="mailing", line1="Office 1204, Business Bay Tower", city_id=dubai.id if dubai else None, country_id=uae.id if uae else None, is_primary=True))
            db.add(OwnerContact(owner_id=company_owner.id, full_name="Amira Al-Farsi", designation="Asset Manager", email="amira" + chr(64) + "skylineholdings.com", phone="+971-4-555-0101", is_primary=True))

            db.commit()
            print("✔ Sample property owners ensured (OWN-000001 Robert Chen, OWN-000002 Skyline Holdings LLC)")
        else:
            print("↷ Property owners already exist, skipping sample owner seed")

        # ---------------- Sample Lease Agreements (Phase 3) ----------------
        if db.query(LeaseAgreement).count() == 0:
            robert = db.query(Owner).filter(Owner.owner_code == "OWN-000001").first()
            skyline = db.query(Owner).filter(Owner.owner_code == "OWN-000002").first()
            today = date.today()

            if robert:
                active_lease = LeaseAgreement(
                    contract_number="LSE-000001",
                    owner_id=robert.id,
                    branch_id=branch.id,
                    property_reference="Unit 4B, 456 Sunset Blvd, Los Angeles — 2BR residential unit",
                    start_date=today - timedelta(days=180),
                    end_date=today + timedelta(days=185),
                    signed_date=today - timedelta(days=190),
                    is_renewable=True,
                    renewal_notice_days=30,
                    payment_frequency="monthly",
                    rent_amount=Decimal("2500.00"),
                    currency_id=us_currency.id if us_currency else None,
                    security_deposit_amount=Decimal("5000.00"),
                    security_deposit_status="held",
                    contract_status=LeaseStatus.ACTIVE,
                    notes_summary="Standard residential lease, auto-renewing tenant relationship.",
                )
                db.add(active_lease)

            if skyline:
                draft_lease = LeaseAgreement(
                    contract_number="LSE-000002",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    property_reference="Floors 3-5, Business Bay Tower, Dubai — commercial office space",
                    start_date=today + timedelta(days=15),
                    end_date=today + timedelta(days=365 * 3),
                    is_renewable=True,
                    renewal_notice_days=60,
                    payment_frequency="quarterly",
                    rent_amount=Decimal("45000.00"),
                    currency_id=None,
                    security_deposit_amount=Decimal("90000.00"),
                    security_deposit_status="held",
                    contract_status=LeaseStatus.DRAFT,
                    notes_summary="Pending signature; 3-year commercial lease under negotiation.",
                )
                db.add(draft_lease)

            db.commit()
            print("✔ Sample lease agreements ensured (LSE-000001 active, LSE-000002 draft)")
        else:
            print("↷ Lease agreements already exist, skipping sample lease seed")

        # ---------------- Amenities catalog (Phase 4) ----------------
        for a in AMENITIES:
            if not db.query(Amenity).filter(Amenity.name == a["name"]).first():
                db.add(Amenity(**a))
        db.commit()
        print(f"✔ Amenities catalog ensured ({len(AMENITIES)} items)")

        # ---------------- Sample Properties (Phase 4) ----------------
        if db.query(Property).count() == 0:
            robert = db.query(Owner).filter(Owner.owner_code == "OWN-000001").first()
            skyline = db.query(Owner).filter(Owner.owner_code == "OWN-000002").first()
            pool = db.query(Amenity).filter(Amenity.name == "Swimming Pool").first()
            parking_amenity = db.query(Amenity).filter(Amenity.name == "Parking").first()
            security = db.query(Amenity).filter(Amenity.name == "24/7 Security").first()
            elevator = db.query(Amenity).filter(Amenity.name == "Elevator").first()
            dock = db.query(Amenity).filter(Amenity.name == "Loading Dock").first()

            if robert:
                villa = Property(
                    property_code="PRP-000001",
                    internal_code="VILLA-LA-01",
                    property_type="villa",
                    title="Sunset Villa",
                    description="2BR standalone villa with private garden.",
                    owner_id=robert.id,
                    branch_id=branch.id,
                    address_line1="456 Sunset Blvd",
                    city_id=la.id if la else None,
                    country_id=us.id,
                    latitude=Decimal("34.098900"),
                    longitude=Decimal("-118.329400"),
                    area_sqm=Decimal("180.50"),
                    bedrooms=2,
                    bathrooms=2,
                    furnishing_status="unfurnished",
                    availability_status="leased",
                )
                if pool:
                    villa.amenities.append(pool)
                if parking_amenity:
                    villa.amenities.append(parking_amenity)
                db.add(villa)
                db.flush()

                active_lease = db.query(LeaseAgreement).filter(LeaseAgreement.contract_number == "LSE-000001").first()
                if active_lease:
                    active_lease.property_id = villa.id

            if skyline:
                building = Property(
                    property_code="PRP-000002",
                    internal_code="BBT-TOWER",
                    property_type="building",
                    title="Business Bay Tower",
                    description="Commercial tower, floors 3-5 under company management.",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    address_line1="Business Bay",
                    city_id=dubai.id if dubai else None,
                    country_id=uae.id if uae else None,
                    total_floors=20,
                    year_built=2015,
                    availability_status="available",
                )
                if security:
                    building.amenities.append(security)
                if elevator:
                    building.amenities.append(elevator)
                db.add(building)
                db.flush()

                floor_3 = Floor(building_id=building.id, floor_number="3", floor_name="Floor 3", total_units=4)
                floor_4 = Floor(building_id=building.id, floor_number="4", floor_name="Floor 4", total_units=4)
                floor_5 = Floor(building_id=building.id, floor_number="5", floor_name="Floor 5 — Penthouse", total_units=2)
                db.add_all([floor_3, floor_4, floor_5])
                db.flush()

                parking_spot = Property(
                    property_code="PRP-000005",
                    internal_code="BBT-P-12",
                    property_type="parking",
                    parent_property_id=building.id,
                    title="Business Bay Tower — Basement Parking Spot 12",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    city_id=dubai.id if dubai else None,
                    country_id=uae.id if uae else None,
                    availability_status="reserved",
                )
                storage_unit = Property(
                    property_code="PRP-000006",
                    internal_code="BBT-S-03",
                    property_type="storage",
                    parent_property_id=building.id,
                    title="Business Bay Tower — Storage Unit 3",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    city_id=dubai.id if dubai else None,
                    country_id=uae.id if uae else None,
                    availability_status="reserved",
                )
                db.add_all([parking_spot, storage_unit])
                db.flush()

                office_unit = Property(
                    property_code="PRP-000003",
                    internal_code="BBT-F3",
                    property_type="office",
                    parent_property_id=building.id,
                    title="Business Bay Tower — Floor 3 Office Suite",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    address_line1="Business Bay",
                    city_id=dubai.id if dubai else None,
                    country_id=uae.id if uae else None,
                    floor_number="3",
                    floor_id=floor_3.id,
                    unit_number="301",
                    rent_price=Decimal("15000.00"),
                    electricity_meter_number="DEWA-EM-88213",
                    water_meter_number="DEWA-WM-88213",
                    parking_space_id=parking_spot.id,
                    storage_space_id=storage_unit.id,
                    area_sqm=Decimal("650.00"),
                    furnishing_status="semi_furnished",
                    availability_status="reserved",
                )
                db.add(office_unit)
                db.flush()

                draft_lease = db.query(LeaseAgreement).filter(LeaseAgreement.contract_number == "LSE-000002").first()
                if draft_lease:
                    draft_lease.property_id = building.id

                warehouse = Property(
                    property_code="PRP-000004",
                    internal_code="WH-DXB-01",
                    property_type="warehouse",
                    title="Al Quoz Warehouse 12",
                    owner_id=skyline.id,
                    branch_id=branch.id,
                    address_line1="Al Quoz Industrial Area 3",
                    city_id=dubai.id if dubai else None,
                    country_id=uae.id if uae else None,
                    area_sqm=Decimal("2200.00"),
                    availability_status="available",
                )
                if dock:
                    warehouse.amenities.append(dock)
                db.add(warehouse)

            db.commit()
            print("✔ Sample properties ensured (PRP-000001..000006: Villa, Building, Office unit, Warehouse, Parking, Storage)")
            print("✔ Sample floors ensured (Floor 3/4/5 in Business Bay Tower)")
        else:
            print("↷ Properties already exist, skipping sample property seed")

        # ---------------- Sample Tenants (Phase 6) ----------------
        if db.query(Tenant).count() == 0:
            individual_tenant = Tenant(
                tenant_code="TNT-000001",
                tenant_type="individual",
                first_name="Laura",
                last_name="Martinez",
                national_id="B7654321",
                passport_number="P1122334",
                nationality_id=us.id,
                primary_email="laura.martinez" + chr(64) + "tenantdemo.com",
                primary_phone="+1-555-0177",
                branch_id=branch.id,
            )
            db.add(individual_tenant)
            db.flush()
            db.add(TenantEmergencyContact(
                tenant_id=individual_tenant.id, full_name="Carlos Martinez", relationship_type="spouse",
                phone="+1-555-0178", is_primary=True,
            ))

            company_tenant = Tenant(
                tenant_code="TNT-000002",
                tenant_type="company",
                company_name="Northwind Logistics FZE",
                commercial_registration_number="CR-55012",
                tax_number="TAX-77031",
                contact_person_name="Farah Al-Sayed",
                contact_person_title="Operations Manager",
                primary_email="contact" + chr(64) + "northwindlogistics.com",
                primary_phone="+971-4-555-0200",
                branch_id=branch.id,
            )
            db.add(company_tenant)
            db.flush()
            db.add(TenantContact(
                tenant_id=company_tenant.id, full_name="Farah Al-Sayed", designation="Operations Manager",
                email="farah" + chr(64) + "northwindlogistics.com", phone="+971-4-555-0201", is_primary=True,
            ))

            blacklisted_tenant = Tenant(
                tenant_code="TNT-000003",
                tenant_type="individual",
                first_name="Derek",
                last_name="Voss",
                national_id="C9988776",
                primary_email="derek.voss" + chr(64) + "tenantdemo.com",
                primary_phone="+1-555-0199",
                branch_id=branch.id,
                is_blacklisted=True,
                blacklist_reason="Repeated late rent payments and property damage at previous unit.",
                blacklisted_at=datetime.now(),
            )
            db.add(blacklisted_tenant)

            db.commit()
            print("✔ Sample tenants ensured (TNT-000001 Laura Martinez, TNT-000002 Northwind Logistics FZE, TNT-000003 Derek Voss [blacklisted])")
        else:
            print("↷ Tenants already exist, skipping sample tenant seed")

        # ---------------- Sample Rental Contracts (Phase 7) ----------------
        if db.query(RentalContract).count() == 0:
            laura = db.query(Tenant).filter(Tenant.tenant_code == "TNT-000001").first()
            northwind = db.query(Tenant).filter(Tenant.tenant_code == "TNT-000002").first()
            villa = db.query(Property).filter(Property.property_code == "PRP-000001").first()
            warehouse = db.query(Property).filter(Property.property_code == "PRP-000004").first()
            today = date.today()

            if laura and villa:
                active_rental = RentalContract(
                    contract_number="RNT-000001",
                    tenant_id=laura.id,
                    property_id=villa.id,
                    branch_id=branch.id,
                    start_date=today - timedelta(days=150),
                    end_date=today + timedelta(days=215),
                    signed_date=today - timedelta(days=155),
                    is_renewable=True,
                    renewal_notice_days=30,
                    payment_frequency="monthly",
                    rent_amount=Decimal("3200.00"),
                    currency_id=us_currency.id if us_currency else None,
                    security_deposit_amount=Decimal("6400.00"),
                    security_deposit_status="held",
                    discount_type="fixed",
                    discount_value=Decimal("100.00"),
                    discount_reason="Loyalty discount — long-term tenant",
                    tax_rate=Decimal("0.00"),
                    late_fee_type="fixed",
                    late_fee_value=Decimal("50.00"),
                    late_fee_grace_period_days=5,
                    contract_status=RentalContractStatus.ACTIVE,
                    notes_summary="Sub-leased from Sunset Villa (PRP-000001), leased from owner Robert Chen under LSE-000001.",
                )
                db.add(active_rental)
                villa.availability_status = "leased"

            if northwind and warehouse:
                draft_rental = RentalContract(
                    contract_number="RNT-000002",
                    tenant_id=northwind.id,
                    property_id=warehouse.id,
                    branch_id=branch.id,
                    start_date=today + timedelta(days=10),
                    end_date=today + timedelta(days=375),
                    is_renewable=True,
                    renewal_notice_days=45,
                    payment_frequency="quarterly",
                    rent_amount=Decimal("18000.00"),
                    security_deposit_amount=Decimal("36000.00"),
                    security_deposit_status="held",
                    discount_type="none",
                    tax_rate=Decimal("5.00"),
                    late_fee_type="percentage",
                    late_fee_value=Decimal("2.00"),
                    late_fee_grace_period_days=7,
                    contract_status=RentalContractStatus.DRAFT,
                    notes_summary="Pending signature; warehouse sublease for logistics operations.",
                )
