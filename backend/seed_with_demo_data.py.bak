        else:
            print("↷ Rental contracts already exist, skipping sample rental seed")

        # ---------------- Sample Financial Data (Phase 8) ----------------
        if db.query(FinancialAccount).count() == 0:
            cash_account = FinancialAccount(
                account_code="ACC-000001", account_type="cash", name="Petty Cash — Head Office",
                branch_id=branch.id, opening_balance=Decimal("2000.00"), is_default=True,
            )
            bank_account = FinancialAccount(
                account_code="ACC-000002", account_type="bank", name="Main Operating Account",
                bank_name="First National Bank", account_number="0091827364", iban="US00FNB0091827364",
                currency_id=us_currency.id if us_currency else None, branch_id=branch.id,
                opening_balance=Decimal("50000.00"),
            )
            db.add_all([cash_account, bank_account])
            db.flush()

            laura = db.query(Tenant).filter(Tenant.tenant_code == "TNT-000001").first()
            robert = db.query(Owner).filter(Owner.owner_code == "OWN-000001").first()
            active_rental = db.query(RentalContract).filter(RentalContract.contract_number == "RNT-000001").first()
            today = date.today()

            # ---------------- Rental Receipt Module demo data ----------------
            if active_rental and db.query(RentalPaymentInstallment).filter(RentalPaymentInstallment.contract_id == active_rental.id).count() == 0:
                last_month_due = today.replace(day=1) - timedelta(days=1)
                db.add(RentalPaymentInstallment(
                    contract_id=active_rental.id, installment_number=1, due_date=last_month_due,
                    amount=active_rental.rent_amount, discount_amount=active_rental.discount_value or Decimal("0"),
                    payment_status=RentalInstallmentStatus.PAID, paid_date=last_month_due + timedelta(days=3),
                    payment_method="bank_transfer", reference_number="REF-88213",
                    receipt_number="RR-000001", printed_at=datetime.utcnow() - timedelta(days=25), print_count=1,
                ))
                db.add(RentalPaymentInstallment(
                    contract_id=active_rental.id, installment_number=2, due_date=today.replace(day=1),
                    amount=active_rental.rent_amount, discount_amount=active_rental.discount_value or Decimal("0"),
                    payment_status=RentalInstallmentStatus.PENDING,
                    receipt_number="RR-000002", printed_at=datetime.utcnow() - timedelta(days=1), print_count=1,
                ))
                db.commit()
                print("✔ Sample rental receipts ensured (RR-000001 confirmed/paid, RR-000002 generated & printed, awaiting payment confirmation)")

            if laura and active_rental:
                payment_txn = Transaction(
                    transaction_number="TXN-000001", transaction_type=TransactionType.TENANT_PAYMENT,
                    direction=TransactionDirection.IN, amount=Decimal("3100.00"), account_id=bank_account.id,
                    tenant_id=laura.id, rental_contract_id=active_rental.id, property_id=active_rental.property_id,
                    payment_method="bank_transfer", reference_number="REF-88213",
                    transaction_date=today - timedelta(days=20), description="Monthly rent — Sunset Villa",
                )
                db.add(payment_txn)
                db.flush()
                db.add(Receipt(receipt_number="RCP-000001", transaction_id=payment_txn.id, issued_date=payment_txn.transaction_date))

            if robert:
                owner_payment_txn = Transaction(
                    transaction_number="TXN-000002", transaction_type=TransactionType.OWNER_PAYMENT,
                    direction=TransactionDirection.OUT, amount=Decimal("2500.00"), account_id=bank_account.id,
                    owner_id=robert.id, property_id=active_rental.property_id if active_rental else None,
                    payment_method="bank_transfer", reference_number="REF-88214",
                    transaction_date=today - timedelta(days=18), description="Monthly lease payment to owner — LSE-000001",
                )
                db.add(owner_payment_txn)
                db.flush()
                db.add(Receipt(receipt_number="RCP-000002", transaction_id=owner_payment_txn.id, issued_date=owner_payment_txn.transaction_date))

            business_bay_tower = db.query(Property).filter(Property.property_code == "PRP-000002").first()

            db.add(Transaction(
                transaction_number="TXN-000003", transaction_type=TransactionType.EXPENSE,
                direction=TransactionDirection.OUT, amount=Decimal("450.00"), account_id=cash_account.id,
                category="maintenance", property_id=active_rental.property_id if active_rental else None,
                transaction_date=today - timedelta(days=10),
                description="Plumbing repair — Sunset Villa",
            ))
            db.add(Transaction(
                transaction_number="TXN-000004", transaction_type=TransactionType.INCOME,
                direction=TransactionDirection.IN, amount=Decimal("150.00"), account_id=cash_account.id,
                category="parking_fee", property_id=business_bay_tower.id if business_bay_tower else None,
                transaction_date=today - timedelta(days=5),
                description="Guest parking fee — Business Bay Tower",
            ))

            transfer_out = Transaction(
                transaction_number="TXN-000005", transaction_type=TransactionType.TRANSFER_OUT,
                direction=TransactionDirection.OUT, amount=Decimal("500.00"), account_id=bank_account.id,
                transaction_date=today - timedelta(days=2), description="Transfer to Petty Cash",
            )
            db.add(transfer_out)
            db.flush()
            transfer_in = Transaction(
                transaction_number="TXN-000006", transaction_type=TransactionType.TRANSFER_IN,
                direction=TransactionDirection.IN, amount=Decimal("500.00"), account_id=cash_account.id,
                transfer_pair_id=transfer_out.id, transaction_date=today - timedelta(days=2),
                description="Transfer from Main Operating Account",
            )
            db.add(transfer_in)
            db.flush()
            transfer_out.transfer_pair_id = transfer_in.id

            if laura:
                db.add(Invoice(
                    invoice_number="INV-000001", tenant_id=laura.id,
                    rental_contract_id=active_rental.id if active_rental else None,
                    property_id=active_rental.property_id if active_rental else None,
                    amount=Decimal("3100.00"), issue_date=today, due_date=today + timedelta(days=15),
                    invoice_status=InvoiceStatus.DRAFT, description="Next month's rent — Sunset Villa",
                ))

            # ---------------- Rent Billing Engine sample invoice ----------------
            if laura and active_rental and db.query(Invoice).filter(Invoice.invoice_number == "INV-000002").count() == 0:
                period_start = today.replace(day=1)
                db.add(Invoice(
                    invoice_number="INV-000002", tenant_id=laura.id,
                    rental_contract_id=active_rental.id, property_id=active_rental.property_id,
                    amount=Decimal("3100.00"), amount_paid=Decimal("1500.00"),
                    issue_date=period_start, due_date=period_start + timedelta(days=15),
                    invoice_status=InvoiceStatus.PARTIALLY_PAID,
                    description=f"Rent for {period_start.strftime('%B %Y')}",
                    billing_cycle="monthly", billing_period_start=period_start,
                    billing_period_end=period_start + timedelta(days=29),
                    snapshot={
                        "tenant_name": "Laura Martinez", "tenant_address": laura.address,
                        "property_title": "Sunset Villa", "contract_number": active_rental.contract_number,
                        "rent_amount": "3100.00", "company_name": "Demo Property Management Co.",
                    },
                    print_count=1, printed_at=datetime.utcnow() - timedelta(days=2),
                    qr_token=str(uuid.uuid4()),
                ))

            db.commit()
            print("✔ Sample financial data ensured (2 accounts, 6 transactions, 2 receipts, 1 draft invoice, 1 partially-paid billing-engine invoice)")
        else:
            print("↷ Financial data already exists, skipping sample financial seed")

        # ---------------- Sample Maintenance Data (Phase 9) ----------------
        if db.query(Contractor).count() == 0:
            contractor = Contractor(
                contractor_code="CON-000001", company_name="CoolBreeze HVAC Services",
                contact_person="Amir Hassan", phone="+971-4-555-0142",
                email="dispatch" + chr(64) + "coolbreeze-hvac.example.com",
                specialty="hvac", hourly_rate=Decimal("85.00"),
                notes="Preferred vendor for HVAC repairs across all branches.",
            )
            db.add(contractor)
            db.flush()

            in_house_tech = Technician(
                technician_code="TEC-000001", first_name="Yusuf", last_name="Odeh",
                phone="+971-50-555-0199", specialty="plumbing", hourly_rate=Decimal("45.00"),
                notes="In-house maintenance staff, Head Office branch.",
            )
            contracted_tech = Technician(
                technician_code="TEC-000002", first_name="Priya", last_name="Nair",
                phone="+971-50-555-0173", specialty="hvac", contractor_id=contractor.id,
                hourly_rate=Decimal("65.00"), notes="Senior HVAC technician at CoolBreeze.",
            )
            db.add_all([in_house_tech, contracted_tech])
            db.flush()

            villa = db.query(Property).filter(Property.property_code == "PRP-000001").first()
            warehouse = db.query(Property).filter(Property.property_code == "PRP-000004").first()
            laura = db.query(Tenant).filter(Tenant.tenant_code == "TNT-000001").first()
            today = date.today()

            if villa:
                completed_request = MaintenanceRequest(
                    request_number="MNT-000001", property_id=villa.id,
                    tenant_id=laura.id if laura else None,
                    title="Kitchen sink leak", description="Slow leak under the kitchen sink, water pooling in the cabinet.",
                    category="plumbing", priority=MaintenancePriority.HIGH,
                    maintenance_status=MaintenanceRequestStatus.COMPLETED,
                    reported_date=today - timedelta(days=20), scheduled_date=today - timedelta(days=18),
                    completed_date=today - timedelta(days=15),
                    assigned_technician_id=in_house_tech.id, estimated_cost=Decimal("150.00"),
                )
                db.add(completed_request)
                db.flush()
                db.add(MaintenanceMaterial(request_id=completed_request.id, name="P-trap fitting", quantity=Decimal("1"), unit_cost=Decimal("18.50"), supplier="Ace Hardware"))
                db.add(MaintenanceMaterial(request_id=completed_request.id, name="Plumber's sealant tape", quantity=Decimal("2"), unit_cost=Decimal("4.25"), supplier="Ace Hardware"))
                db.add(MaintenanceLaborCost(
                    request_id=completed_request.id, technician_id=in_house_tech.id,
                    work_date=today - timedelta(days=18), hours=Decimal("2.5"), hourly_rate=Decimal("45.00"),
                    description="Diagnosed and replaced P-trap fitting, resealed connections.",
                ))

            if warehouse:
                in_progress_request = MaintenanceRequest(
                    request_number="MNT-000002", property_id=warehouse.id,
                    title="HVAC unit not cooling", description="Main warehouse HVAC unit blowing warm air, urgent given stored inventory.",
                    category="hvac", priority=MaintenancePriority.URGENT,
                    maintenance_status=MaintenanceRequestStatus.IN_PROGRESS,
                    reported_date=today - timedelta(days=3), scheduled_date=today,
                    assigned_contractor_id=contractor.id, assigned_technician_id=contracted_tech.id,
                    estimated_cost=Decimal("600.00"),
                )
                db.add(in_progress_request)
                db.flush()
                db.add(MaintenanceLaborCost(
                    request_id=in_progress_request.id, technician_id=contracted_tech.id, contractor_id=contractor.id,
                    work_date=today - timedelta(days=1), hours=Decimal("3.0"), hourly_rate=Decimal("65.00"),
                    description="Initial diagnostic — compressor issue suspected, parts on order.",
                ))

                reported_request = MaintenanceRequest(
                    request_number="MNT-000003", property_id=warehouse.id,
                    title="Loading dock light out", description="One of the loading dock exterior lights is not turning on at night.",
                    category="electrical", priority=MaintenancePriority.MEDIUM,
                    maintenance_status=MaintenanceRequestStatus.REPORTED,
                    reported_date=today,
                )
                db.add(reported_request)

            # ---- Maintenance Contracts extension: recurring/annual service
            # contracts (elevators, HVAC/AC) — separate from the ad-hoc
            # requests above. ----
            elevator_contractor = Contractor(
                contractor_code="CON-000002", company_name="SkyLift Elevator Services",
                contact_person="Nadia Fares", phone="+971-4-555-0188",
                email="service" + chr(64) + "skylift-elevators.example.com",
                specialty="elevator", hourly_rate=Decimal("95.00"),
                notes="Certified elevator maintenance & inspection vendor.",
            )
            db.add(elevator_contractor)
            db.flush()

            # Queried directly (not reused from the Financial Data block
            # above) so this seed step works standalone regardless of
            # whether that other block ran in this pass.
            elevator_building = db.query(Property).filter(Property.property_code == "PRP-000002").first()

            if elevator_building:
                elevator_contract = MaintenanceContract(
                    contract_number="MTC-000001", property_id=elevator_building.id,
                    contractor_id=elevator_contractor.id, service_type="elevator",
                    title="Annual Elevator Maintenance Contract — Business Bay Tower",
                    description="Quarterly inspection & servicing of all building elevators, per municipality safety code.",
                    start_date=today.replace(month=1, day=1), end_date=today.replace(month=12, day=31),
                    signed_date=today.replace(month=1, day=1) - timedelta(days=5),
                    visit_frequency="quarterly", visits_per_year=4,
                    next_service_due_date=today + timedelta(days=25),
                    annual_cost=Decimal("8400.00"), contract_status=MaintenanceContractStatus.ACTIVE,
                    notes="Covers 2 passenger elevators. Emergency callouts billed separately.",
                )
                db.add(elevator_contract)

            if villa:
                ac_contract = MaintenanceContract(
                    contract_number="MTC-000002", property_id=villa.id,
                    contractor_id=contractor.id, service_type="hvac",
                    title="Annual AC Maintenance Contract — Sunset Villa",
                    description="Bi-annual AC unit servicing (filter cleaning, gas check, coil cleaning) ahead of summer/winter seasons.",
                    start_date=today.replace(month=1, day=1), end_date=today.replace(month=12, day=31),
                    signed_date=today.replace(month=1, day=1) - timedelta(days=3),
                    visit_frequency="semi_annual", visits_per_year=2,
                    next_service_due_date=today + timedelta(days=10),
                    annual_cost=Decimal("1200.00"), contract_status=MaintenanceContractStatus.ACTIVE,
                    notes="Covers all split units on the property.",
                )
                db.add(ac_contract)

            db.commit()
            print("✔ Sample maintenance data ensured (2 contractors, 2 technicians, 3 requests, 2 recurring service contracts: elevator + AC)")
        else:
            print("↷ Maintenance data already exists, skipping sample maintenance seed")

        # ---------------- Sample Accounting Data (Phase 10) ----------------
        if db.query(ChartOfAccount).count() == 0:
            today = date.today()

            def coa(code, name, acc_type, parent=None, allow_posting=True):
                acct = ChartOfAccount(account_code=code, account_name=name, account_type=acc_type, parent_account_id=parent.id if parent else None, allow_posting=allow_posting)
                db.add(acct)
                db.flush()
                return acct

            assets = coa("1000", "Assets", "asset", allow_posting=False)
            current_assets = coa("1100", "Current Assets", "asset", parent=assets, allow_posting=False)
            cash_on_hand = coa("1110", "Cash on Hand", "asset", parent=current_assets)
            bank_operating = coa("1120", "Bank - Operating Account", "asset", parent=current_assets)

            liabilities = coa("2000", "Liabilities", "liability", allow_posting=False)
            current_liabilities = coa("2100", "Current Liabilities", "liability", parent=liabilities, allow_posting=False)
            security_deposits = coa("2110", "Security Deposits Held", "liability", parent=current_liabilities)
            vat_control = coa("2200", "VAT Control", "liability", parent=current_liabilities)

            equity = coa("3000", "Equity", "equity", allow_posting=False)
            retained_earnings = coa("3100", "Retained Earnings", "equity", parent=equity)

            revenue = coa("4000", "Revenue", "revenue", allow_posting=False)
            rental_income = coa("4100", "Rental Income", "revenue", parent=revenue)
            other_income = coa("4200", "Other Income", "revenue", parent=revenue)

            expenses = coa("5000", "Expenses", "expense", allow_posting=False)
            maintenance_expense = coa("5100", "Maintenance Expense", "expense", parent=expenses)
            owner_disbursements = coa("5200", "Owner Disbursements", "expense", parent=expenses)
            refunds_issued = coa("5300", "Refunds Issued", "expense", parent=expenses)
            general_expense = coa("5900", "General Operating Expense", "expense", parent=expenses)

            # Link Phase 8 Cash/Bank accounts to their GL ledger accounts so
            # Automatic Posting knows which GL account to hit.
            cash_account = db.query(FinancialAccount).filter(FinancialAccount.account_code == "ACC-000001").first()
            bank_account = db.query(FinancialAccount).filter(FinancialAccount.account_code == "ACC-000002").first()
            if cash_account:
                cash_account.gl_account_id = cash_on_hand.id
            if bank_account:
                bank_account.gl_account_id = bank_operating.id

            villa = db.query(Property).filter(Property.property_code == "PRP-000001").first()
            warehouse = db.query(Property).filter(Property.property_code == "PRP-000004").first()
            cc_villa = CostCenter(cost_center_code="CC-000001", name="Sunset Villa Operations", property_id=villa.id if villa else None)
            cc_warehouse = CostCenter(cost_center_code="CC-000002", name="Warehouse Operations", property_id=warehouse.id if warehouse else None)
            db.add_all([cc_villa, cc_warehouse])
            db.flush()

            vat_std = VatRate(code="STD5", name="Standard Rate 5%", rate_percentage=Decimal("5.00"), gl_account_id=vat_control.id)
            vat_zero = VatRate(code="ZERO0", name="Zero-Rated 0%", rate_percentage=Decimal("0.00"))
            db.add_all([vat_std, vat_zero])
            db.flush()

            # Posting rules left VAT-free by default — Phase 8 amounts were
            # recorded without a tax-inclusive assumption, so applying VAT
            # retroactively to the default mapping would silently change
            # what those historical dollar amounts mean. VAT-aware rules can
            # be added deliberately (see docs/phase10-validation-rules.md).
            db.add_all([
                PostingRule(transaction_type="tenant_payment", offset_account_id=rental_income.id),
                PostingRule(transaction_type="owner_payment", offset_account_id=owner_disbursements.id),
                PostingRule(transaction_type="expense", offset_account_id=general_expense.id),
                PostingRule(transaction_type="expense", category="maintenance", offset_account_id=maintenance_expense.id),
                PostingRule(transaction_type="income", offset_account_id=other_income.id),
                PostingRule(transaction_type="deposit_received", offset_account_id=security_deposits.id),
                PostingRule(transaction_type="deposit_refund", offset_account_id=security_deposits.id),
                PostingRule(transaction_type="refund", offset_account_id=refunds_issued.id),
            ])
            db.flush()

            # Opening balances entry — matches the Phase 8 opening_balance
            # figures already seeded on ACC-000001 / ACC-000002.
            opening_entry = JournalEntry(
                entry_number="JE-000001", entry_date=today - timedelta(days=30),
                description="Opening balances", source_type=SourceType.MANUAL,
                entry_status=EntryStatus.POSTED, posted_at=datetime.utcnow(),
            )
            db.add(opening_entry)
            db.flush()
            db.add_all([
                JournalEntryLine(journal_entry_id=opening_entry.id, account_id=cash_on_hand.id, debit_amount=Decimal("2000.00"), credit_amount=0, description="Opening cash balance"),
                JournalEntryLine(journal_entry_id=opening_entry.id, account_id=bank_operating.id, debit_amount=Decimal("50000.00"), credit_amount=0, description="Opening bank balance"),
                JournalEntryLine(journal_entry_id=opening_entry.id, account_id=retained_earnings.id, debit_amount=0, credit_amount=Decimal("52000.00"), description="Opening retained earnings"),
            ])

            # Demonstration system-style entries mirroring what Automatic
            # Posting will now produce going forward for new transactions.
            # (The 6 Phase 8 sample transactions were inserted directly,
            # bypassing the service layer/hook — same seeding pattern used
            # in every prior phase — so these are seeded explicitly here to
            # keep the ledger consistent with the seeded transactions.)
            tenant_payment_txn = db.query(Transaction).filter(Transaction.transaction_number == "TXN-000001").first()
            owner_payment_txn = db.query(Transaction).filter(Transaction.transaction_number == "TXN-000002").first()

            if tenant_payment_txn:
                je2 = JournalEntry(
                    entry_number="JE-000002", entry_date=tenant_payment_txn.transaction_date,
                    description=f"Auto-posted: {tenant_payment_txn.transaction_number} (tenant_payment)",
                    reference_number=tenant_payment_txn.transaction_number, source_type=SourceType.SYSTEM,
                    source_transaction_id=tenant_payment_txn.id, entry_status=EntryStatus.POSTED, posted_at=datetime.utcnow(),
                )
                db.add(je2)
                db.flush()
                db.add_all([
                    JournalEntryLine(journal_entry_id=je2.id, account_id=bank_operating.id, property_id=tenant_payment_txn.property_id, debit_amount=tenant_payment_txn.amount, credit_amount=0),
                    JournalEntryLine(journal_entry_id=je2.id, account_id=rental_income.id, cost_center_id=cc_villa.id, property_id=tenant_payment_txn.property_id, debit_amount=0, credit_amount=tenant_payment_txn.amount),
                ])

            if owner_payment_txn:
                je3 = JournalEntry(
                    entry_number="JE-000003", entry_date=owner_payment_txn.transaction_date,
                    description=f"Auto-posted: {owner_payment_txn.transaction_number} (owner_payment)",
                    reference_number=owner_payment_txn.transaction_number, source_type=SourceType.SYSTEM,
                    source_transaction_id=owner_payment_txn.id, entry_status=EntryStatus.POSTED, posted_at=datetime.utcnow(),
                )
                db.add(je3)
                db.flush()
                db.add_all([
                    JournalEntryLine(journal_entry_id=je3.id, account_id=owner_disbursements.id, cost_center_id=cc_villa.id, property_id=owner_payment_txn.property_id, debit_amount=owner_payment_txn.amount, credit_amount=0),
                    JournalEntryLine(journal_entry_id=je3.id, account_id=bank_operating.id, property_id=owner_payment_txn.property_id, debit_amount=0, credit_amount=owner_payment_txn.amount),
                ])

            # A draft entry left unposted, to exercise the draft -> post workflow.
            draft_entry = JournalEntry(
                entry_number="JE-000004", entry_date=today, description="Accrued general expense (pending review)",
                source_type=SourceType.MANUAL, entry_status=EntryStatus.DRAFT,
            )
            db.add(draft_entry)
            db.flush()
            db.add_all([
                JournalEntryLine(journal_entry_id=draft_entry.id, account_id=general_expense.id, debit_amount=Decimal("300.00"), credit_amount=0, description="Pending office supplies invoice"),
                JournalEntryLine(journal_entry_id=draft_entry.id, account_id=cash_on_hand.id, debit_amount=0, credit_amount=Decimal("300.00"), description="Pending office supplies invoice"),
            ])

            db.commit()
            print("✔ Sample accounting data ensured (15 GL accounts, 2 cost centers, 2 VAT rates, 8 posting rules, 4 journal entries [3 posted incl. opening balances, 1 draft])")
        else:
            print("↷ Accounting data already exists, skipping sample accounting seed")

        # ---------------- Sample Report Schedules (Enterprise Reporting) ----------------
        if db.query(ReportSchedule).count() == 0:
            now = datetime.utcnow()
            db.add_all([
                ReportSchedule(
                    name="Monthly Financial Report", report_type="financial", export_format=ReportExportFormat.PDF,
                    frequency=ReportFrequency.MONTHLY, filters=None, is_active=True, next_run_at=now + timedelta(days=30),
                ),
                ReportSchedule(
                    name="Weekly Maintenance Summary", report_type="maintenance", export_format=ReportExportFormat.EXCEL,
                    frequency=ReportFrequency.WEEKLY, filters=None, is_active=True, next_run_at=now + timedelta(days=7),
                ),
                ReportSchedule(
                    name="Daily Collections Snapshot", report_type="collections", export_format=ReportExportFormat.PDF,
                    frequency=ReportFrequency.DAILY, filters={"months": 3}, is_active=False, next_run_at=now + timedelta(days=1),
                ),
            ])
            db.commit()
            print("✔ Sample report schedules ensured (3 schedules: monthly financial PDF, weekly maintenance Excel, daily collections PDF [inactive])")
        else:
            print("↷ Report schedules already exist, skipping sample schedule seed")

        print("\n✅ Seed complete.")
    finally:
        db.close()


if __name__ == "__main__":
    run()
